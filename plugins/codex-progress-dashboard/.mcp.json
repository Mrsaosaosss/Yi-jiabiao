{
  "mcpServers": {
    "codex-progress-dashboard": {
      "command": "python3",
      "args": ["server/mcp_server.py"],
      "cwd": ".",
      "env_vars": ["CODEX_HOME"],
      "startup_timeout_sec": 30,
      "enabled_tools": [
        "open_progress_dashboard",
        "show_progress_hud",
        "progress_dashboard_status"
      ]
    }
  }
}
